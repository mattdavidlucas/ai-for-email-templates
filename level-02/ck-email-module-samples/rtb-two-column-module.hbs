<!-- rtb-two-column-module -->
<tr>
  <td style="padding-bottom: {{ck:defaultable modOSpacerBottomHt '0'}};">
    <table class="mb-87" width="77.8%" border="0" cellpadding="0" cellspacing="0" align="center" style="border-collapse: collapse; margin: 0 auto; width: 77.8%" role="presentation">
      <tr>
        <td align="center" valign="top" style="text-align: center; vertical-align: top;">
          <!--[if (gte mso 9)|(IE)]><table align="center" width="{{#if modODouble}}100%{{else}}264{{/if}}" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;"><tr><td width="264" style="vertical-align: top; width: 264px;"><![endif]-->
          <!-- Column 1 -->
          <table class="md-mw-100" width="264" border="0" cellpadding="0" cellspacing="0" align="{{#if modODouble}}left{{else}}center{{/if}}" style="border-collapse: collapse; {{#if modODouble}}float: left;{{else}}float: none; margin: 0 auto;{{/if}} width: 100%; max-width: 48.529411765%;" role="presentation">
            <tr>
              <td>
                <!-- Single Mod O -->
                <table width="264" border="0" cellpadding="0" cellspacing="0" style="background-color: {{ck:defaultable modO1BgColor '#005b13'}}; border-collapse: collapse; border-radius: 6px; width: 100%; max-width: 264px;" role="presentation">
                  <tr>
                    <td style="padding: 0 16px 16px 16px">
                      <table width="100%" border="0" cellpadding="0" cellspacing="0" align="center" style="border-collapse: collapse; width: 100%" role="presentation">
                        <!-- Header with Icon -->
                        <tr>
                          <td>
                            <table width="100%" border="0" cellpadding="0" cellspacing="0" align="left" style="border-collapse: collapse; width: 100%" role="presentation">
                              <tr>
                                <td width="31.617647059%" style="color: {{ck:defaultable modO1SubheadColor '#FFFFFF'}}; font-weight: bold; font-family: Arial, sans-serif; font-size: 26px; line-height: 30px; padding: {{#if modO1SubheadTwoLine}}8px 16px 8px 0{{else}}23px 16px 23px 0{{/if}}; text-align: left; width: 31.617647059%;">{{#> modO1SubheadText}}{{/modO1SubheadText}}</td>

                                <td width="8.088235294%" style="padding: 8px 0"><img src="{{> common/mediaUrl}}{{modO1IconImgSrc}}" style="border: none; display: block; -ms-interpolation-mode: bicubic; outline: none; height: 44px; width: 44px;" width="44" height="44" alt="{{ck:defaultable modO1IconImgAlt 'symbol'}}" border="0"></td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                        <!-- End Header with Icon -->

                        <!-- Copy -->
                        <tr>
                          <td style="color: {{ck:defaultable modO1CopyColor '#FFFFFF'}}; font-weight: normal; font-family: Arial, sans-serif; font-size: 16px; line-height: 22px; text-align: left;">{{#> modO1Copy}}{{/modO1Copy}}</td>
                        </tr>
                        <!-- End Copy -->
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- End Single Mod O -->
              </td>
            </tr>
          </table>
          <!-- End Column 1 -->
          {{#if modODouble}}
          <!--[if (gte mso 9)|(IE)]></td><td width="16" style="vertical-align: top; width: 16px;"><![endif]-->
            
          <!-- Gutter -->
          <table class="md-mw-100" width="16" border="0" cellpadding="0" cellspacing="0" align="left" style="border-collapse: collapse; float: left; width: 100%; max-width: 2.941176471%;" role="presentation"><tr><td height="16" style="height: 16px; mso-line-height-rule: exactly;  line-height: 16px;">&nbsp;</td></tr></table>
          <!-- End Gutter -->
          
          <!--[if (gte mso 9)|(IE)]></td><td width="264" style="vertical-align: top; width: 264px;"><![endif]-->
          
          <!-- Column 2 -->
          <table class="md-mw-100" width="264" border="0" cellpadding="0" cellspacing="0" align="left" style="border-collapse: collapse; float: left; width: 100%; max-width: 48.529411765%;" role="presentation">
            <tr>
              <td>
                <!-- Single Mod O -->
                <table width="264" border="0" cellpadding="0" cellspacing="0" style="background-color: {{ck:defaultable modO2BgColor '#005b13'}}; border-collapse: collapse; border-radius: 6px; width: 100%; max-width: 264px;" role="presentation">
                  <tr>
                    <td style="padding: 0 16px 16px 16px">
                      <table width="100%" border="0" cellpadding="0" cellspacing="0" align="center" style="border-collapse: collapse; width: 100%" role="presentation">
                        <!-- Header with Icon -->
                        <tr>
                          <td>
                            <table width="100%" border="0" cellpadding="0" cellspacing="0" align="left" style="border-collapse: collapse; width: 100%" role="presentation">
                              <tr>
                                <td width="31.617647059%" style="color: {{ck:defaultable modO2SubheadColor '#FFFFFF'}}; font-weight: bold; font-family: Arial, sans-serif; font-size: 26px; line-height: 30px; padding: {{#if modO2SubheadTwoLine}}8px 16px 8px 0{{else}}23px 16px 23px 0{{/if}}; text-align: left; width: 31.617647059%;">{{#> modO2SubheadText}}{{/modO2SubheadText}}</td>

                                <td width="8.088235294%" style="padding: 8px 0"><img src="{{> common/mediaUrl}}{{modO2IconImgSrc}}" style="border: none; display: block; -ms-interpolation-mode: bicubic; outline: none; height: 44px; width: 44px;" width="44" height="44" alt="{{ck:defaultable modO2IconImgAlt 'symbol'}}" border="0"></td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                        <!-- End Header with Icon -->

                        <!-- Copy -->
                        <tr>
                          <td style="color: {{ck:defaultable modO2CopyColor '#FFFFFF'}}; font-weight: normal; font-family: Arial, sans-serif; font-size: 16px; line-height: 22px; text-align: left;">{{#> modO2Copy}}{{/modO2Copy}}</td>
                        </tr>
                        <!-- End Copy -->
                      </table>
                    </td>
                  </tr>
                </table>
                <!-- End Single Mod O -->
              </td>
            </tr>
          </table>
          <!-- End Column 2 -->
          {{/if}}
          <!--[if (gte mso 9)|(IE)]></td></tr></table><![endif]-->
        </td>
      </tr>
    </table>
  </td>
</tr>
<!-- End Mod O -->